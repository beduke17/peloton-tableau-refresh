      </column>
      <column caption="Workout Duration (Min)" datatype="integer" name="[Calculation_1789495428568]" role="measure" type="quantitative">
        <calculation class="tableau" formula="DATEDIFF(&#13;&#10;  'minute',&#13;&#10;  DATEPARSE(&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, [workout_date]),&#13;&#10;  DATEPARSE(&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, [end_time])&#13;&#10;)"/>
      </column>
      <column caption="Is Selected Instructor" datatype="boolean" name="[Calculation_1789495703810]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[name] = [Parameters].[Parameter 1]"/>
      </column>
      <column caption="Output per 10 Min" datatype="real" name="[Calculation_1789656700001]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(SUM([total_output_kj]) / SUM([Calculation_1789495428568])) * 10"/>
      </column>
      <column caption="Calories per 10 Min" datatype="real" name="[Calculation_1789656700002]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(SUM([calories_kcal]) / SUM([Calculation_1789495428568])) * 10"/>
      </column>
      <column caption="Workout Hour" datatype="integer" name="[Calculation_1789755053052]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATEPART(&#13;&#10;  'hour',&#13;&#10;  DATEPARSE(&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, [workout_date])&#13;&#10;)"/>
      </column>
      <column caption="Workout Day of Week" datatype="string" name="[Calculation_1789755054196]" role="dimension" type="nominal">
        <calculation class="tableau" formula="DATENAME('weekday', [Calculation_1789494884596])"/>
      </column>
      <column caption="Workout Month Name" datatype="string" name="[Calculation_1789755055312]" role="dimension" type="nominal">
        <calculation class="tableau" formula="DATENAME('month', [Calculation_1789494884596])"/>
      </column>
      <column caption="Workout Datetime (UTC)" datatype="datetime" name="[Calculation_1789755482081]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATEPARSE(&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, [workout_date])"/>
      </column>
      <column caption="Workout Datetime (Chicago)" datatype="datetime" name="[Calculation_1789755499040]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATEADD(&#13;&#10;  'hour',&#13;&#10;  IF [Calculation_1789755482081] &gt;= DATEADD(&#13;&#10;    'day',&#13;&#10;    (&#13;&#10;      8 - DATEPART(&#13;&#10;        'weekday',&#13;&#10;        DATE(&#13;&#10;          STR(YEAR([Calculation_1789755482081])) + &quot;-03-01&quot;&#13;&#10;        )&#13;&#10;      ) - INT(&#13;&#10;        (&#13;&#10;          8 - DATEPART(&#13;&#10;            'weekday',&#13;&#10;            DATE(&#13;&#10;              STR(YEAR([Calculation_1789755482081])) +&#13;&#10;                &quot;-03-01&quot;&#13;&#10;            )&#13;&#10;          )&#13;&#10;        ) / 7&#13;&#10;      ) * 7&#13;&#10;    ) + 7,&#13;&#10;    DATE(STR(YEAR([Calculation_1789755482081])) + &quot;-03-01&quot;)&#13;&#10;  ) AND [Calculation_1789755482081] &lt; DATEADD(&#13;&#10;    'day',&#13;&#10;    (&#13;&#10;      8 - DATEPART(&#13;&#10;        'weekday',&#13;&#10;        DATE(&#13;&#10;          STR(YEAR([Calculation_1789755482081])) + &quot;-11-01&quot;&#13;&#10;        )&#13;&#10;      ) - INT(&#13;&#10;        (&#13;&#10;          8 - DATEPART(&#13;&#10;            'weekday',&#13;&#10;            DATE(&#13;&#10;              STR(YEAR([Calculation_1789755482081])) +&#13;&#10;                &quot;-11-01&quot;&#13;&#10;            )&#13;&#10;          )&#13;&#10;        ) / 7&#13;&#10;      ) * 7&#13;&#10;    ),&#13;&#10;    DATE(STR(YEAR([Calculation_1789755482081])) + &quot;-11-01&quot;)&#13;&#10;  )&#13;&#10;  THEN -5&#13;&#10;  ELSE -6&#13;&#10;  END,&#13;&#10;  [Calculation_1789755482081]&#13;&#10;)"/>
      </column>
      <column caption="Workout Hour (Chicago)" datatype="integer" name="[Calculation_1789755517735]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATEPART('hour', [Calculation_1789755499040])"/>
      </column>
      <column caption="Workout Day of Week (Chicago)" datatype="string" name="[Calculation_1789755524489]" role="dimension" type="nominal">
        <calculation class="tableau" formula="DATENAME('weekday', [Calculation_1789755499040])"/>
      </column>
      <column caption="Workout Era" datatype="string" name="[Calculation_1789756400001]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Calculation_1789494884596] &lt; #2020-03-01# THEN &quot;Pre-Pandemic (through Feb 2020)&quot;&#13;&#10;ELSEIF [Calculation_1789494884596] &lt;= #2021-12-31# THEN &quot;Pandemic (Mar 2020 - Dec 2021)&quot;&#13;&#10;ELSE &quot;Post-Pandemic (2022 - present)&quot;&#13;&#10;END"/>
      </column>
      <column caption="Total Hours Worked Out" datatype="real" name="[Calculation_1791329115046]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Calculation_1789495428568]) / 60"/>
      </column>
      <column caption="KPI Constant" datatype="string" name="[Calculation_1791329808604]" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;&quot;"/>
      </column>
      <column caption="MoM % Change - Total Workouts" datatype="real" name="[Calculation_1791384942632]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(COUNTD([workout_id]) - LOOKUP(COUNTD([workout_id]), -1)) /&#13;&#10;  ABS(LOOKUP(COUNTD([workout_id]), -1))">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="MoM % Change - Hours Worked Out" datatype="real" name="[Calculation_1791384952110]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(&#13;&#10;  ZN([Calculation_1791329115046]) - LOOKUP(&#13;&#10;    ZN([Calculation_1791329115046]),&#13;&#10;    -1&#13;&#10;  )&#13;&#10;) / ABS(LOOKUP(ZN([Calculation_1791329115046]), -1))">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="MoM % Change - Miles Traveled" datatype="real" name="[Calculation_1791384957416]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(SUM([distance_miles]) - LOOKUP(SUM([distance_miles]), -1))&#13;&#10;  / ABS(LOOKUP(SUM([distance_miles]), -1))">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="MoM % Change - Total Output" datatype="real" name="[Calculation_1791384960659]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(&#13;&#10;  SUM([total_output_kj]) - LOOKUP(&#13;&#10;    SUM([total_output_kj]),&#13;&#10;    -1&#13;&#10;  )&#13;&#10;) / ABS(LOOKUP(SUM([total_output_kj]), -1))">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="MoM Direction - Total Workouts" datatype="string" name="[Calculation_1791384971224]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ISNULL([Calculation_1791384942632])&#13;&#10;THEN &quot;No Prior Month&quot;&#13;&#10;ELSEIF [Calculation_1791384942632] &gt;= 0&#13;&#10;THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="MoM Direction - Hours Worked Out" datatype="string" name="[Calculation_1791384977746]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ISNULL([Calculation_1791384952110])&#13;&#10;THEN &quot;No Prior Month&quot;&#13;&#10;ELSEIF [Calculation_1791384952110] &gt;= 0&#13;&#10;THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
      <column caption="MoM Direction - Miles Traveled" datatype="string" name="[Calculation_1791386981536]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ISNULL([Calculation_1791384957416])&#13;&#10;THEN &quot;No Prior Month&quot;&#13;&#10;ELSEIF [Calculation_1791384957416] &gt;= 0&#13;&#10;THEN &quot;Increase&quot;&#13;&#10;ELSE &quot;Decrease&quot;&#13;&#10;END">
          <table-calc ordering-type="Rows"/>
        </calculation>
      </column>
